<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>The Job Search Planner — Ultimate V2</title>
<style>
:root{
  --char:#171513; --char2:#221f1c; --paper:#f4efe6; --ivory:#fbf8f2;
  --champagne:#d7c3a6; --sand:#e8ded0; --taupe:#b7a48e; --camel:#9a775b;
  --mocha:#6f5140; --espresso:#3d2f28; --ink:#2a2521; --muted:#756d65;
  --line:#dfd3c4; --danger:#a65e56; --success:#75836b; --shadow:0 16px 40px rgba(55,42,32,.08);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer}
.app{min-height:100vh;display:grid;grid-template-columns:232px minmax(0,1fr)}
.sidebar{background:linear-gradient(180deg,#151311,#201c19 55%,#171513);color:#f8f4ed;position:sticky;top:0;height:100vh;padding:14px 12px;display:flex;flex-direction:column;gap:12px}
.brand{height:120px;border-bottom:1px solid rgba(215,195,166,.35);overflow:hidden;display:flex;align-items:center;justify-content:center}
.brand img{width:100%;height:100%;object-fit:cover}
.nav{display:flex;flex-direction:column;gap:4px;overflow:auto;padding-right:2px}
.nav button{border:0;background:transparent;color:#eee7de;text-align:left;border-radius:11px;padding:10px 12px;display:grid;grid-template-columns:24px 1fr;gap:9px;align-items:center}
.nav button:hover,.nav button.active{background:linear-gradient(90deg,rgba(215,195,166,.20),rgba(215,195,166,.06));box-shadow:inset 3px 0 0 var(--champagne)}
.nav b{font-size:11px;letter-spacing:1.25px}
.nav small{display:block;font-size:8px;color:#bdb2a6;letter-spacing:.8px;margin-top:2px}
.side-quote{margin-top:auto;border:1px solid rgba(215,195,166,.45);border-radius:12px;padding:16px;text-align:center}
.side-quote small{font-size:8px;letter-spacing:1.5px;color:#cfc1b2}
.side-quote strong{display:block;font-family:Georgia,serif;font-size:14px;line-height:1.5;margin-top:10px;color:#f4ecdf}
.main{min-width:0}
.topbar{padding:26px 32px 18px;display:flex;justify-content:space-between;gap:20px;align-items:end}
.eyebrow{font-size:10px;letter-spacing:2px;color:var(--mocha);font-weight:800;text-transform:uppercase}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;color:var(--espresso);margin:0}
h1{font-size:34px;font-weight:500} h2{font-size:27px;font-weight:500} h3{font-size:19px;font-weight:500}
.sub{color:var(--muted);font-size:13px;margin-top:6px}
.btn{border:0;border-radius:10px;padding:11px 16px;font-weight:800;letter-spacing:.8px;font-size:10px}
.btn.primary{background:var(--espresso);color:#fff}
.btn.soft{background:#eadfce;color:var(--espresso);border:1px solid #d8c8b4}
.btn.ghost{background:transparent;border:1px solid var(--line);color:var(--espresso)}
.btn.danger{background:#f3e5e1;color:#8e4d46;border:1px solid #dfc2bc}
.content{padding:0 32px 40px}
.view{display:none} .view.active{display:block}
.hero{background:linear-gradient(135deg,#332a24,#1c1916);color:white;border-radius:18px;padding:28px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero:after{content:"";position:absolute;width:240px;height:240px;border-radius:50%;background:rgba(215,195,166,.10);right:-60px;top:-90px}
.hero-grid{display:grid;grid-template-columns:1fr 220px;gap:18px;align-items:center}
.hero h2{color:#fff;font-size:31px}
.hero p{color:#d8cec2;max-width:700px}
.health{justify-self:end;width:175px;height:175px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(var(--champagne) 0 78%,rgba(255,255,255,.12) 78%);position:relative}
.health:before{content:"";position:absolute;inset:16px;border-radius:50%;background:#27211d}
.health strong{font:500 42px Georgia,serif;z-index:1} .health small{z-index:1;display:block;font-size:8px;letter-spacing:1.5px;color:#cfc5b9;text-align:center}
.grid2{display:grid;grid-template-columns:1.15fr .85fr;gap:16px;margin-top:16px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:14px}
.card{background:rgba(251,248,242,.96);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 7px 24px rgba(70,52,38,.05)}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.kpi{background:#f8f2e9;border:1px solid var(--line);border-radius:14px;padding:15px}
.kpi strong{font:500 28px Georgia,serif;color:var(--espresso)} .kpi small{display:block;color:var(--muted);font-size:9px;letter-spacing:1px;margin-top:4px}
.priority{background:#efe4d4;border:1px solid #ddcab1;border-radius:14px;padding:18px}
.priority .rank{width:30px;height:30px;border-radius:50%;background:var(--espresso);color:white;display:grid;place-items:center;font-weight:800}
.priority-main{display:grid;grid-template-columns:40px 1fr auto;gap:12px;align-items:start}
.meta{font-size:11px;color:var(--muted);margin-top:5px}
.progress{height:8px;background:#e5dace;border-radius:99px;overflow:hidden} .progress i{display:block;height:100%;background:linear-gradient(90deg,var(--camel),var(--mocha));border-radius:99px}
.pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.pipe{text-align:center;padding:14px 8px;background:#f7f1e8;border:1px solid var(--line);border-radius:12px;position:relative}
.pipe:not(:last-child):after{content:"→";position:absolute;right:-13px;top:50%;transform:translateY(-50%);color:#a58f79;z-index:2}
.pipe strong{font:500 24px Georgia,serif;display:block} .pipe span{font-size:9px;letter-spacing:1px;color:var(--muted)}
.insight{display:flex;gap:10px;padding:11px 0;border-bottom:1px solid #eadfd2} .insight:last-child{border:0}
.insight .ico{width:30px;height:30px;border-radius:10px;background:#e9ddcd;display:grid;place-items:center}
.table{width:100%;border-collapse:collapse;font-size:12px} .table th{text-align:left;color:var(--muted);font-size:9px;letter-spacing:1px;padding:9px;border-bottom:1px solid var(--line)} .table td{padding:12px 9px;border-bottom:1px solid #eee4d8}
.pill{display:inline-flex;padding:6px 9px;border-radius:999px;background:#eadfce;color:#594437;font-size:9px;font-weight:800}
.setup-layout{display:grid;grid-template-columns:1fr 320px;gap:18px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
label{font-size:10px;font-weight:800;letter-spacing:.6px;color:#5c4d42}
input,select,textarea{width:100%;border:1px solid var(--line);background:#fffdf9;border-radius:10px;padding:11px;margin-top:6px;color:var(--ink)}
textarea{min-height:90px;resize:vertical}
.days{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}
.day{border:1px solid var(--line);background:white;border-radius:999px;padding:8px 10px;font-size:10px}
.day.on{background:var(--espresso);color:white;border-color:var(--espresso)}
.weight{display:grid;grid-template-columns:1fr 140px 44px;gap:10px;align-items:center;margin:11px 0}
.weight input{margin:0;padding:0} .weight output{font-weight:800;color:var(--mocha)}
.total{display:flex;justify-content:space-between;background:#eee3d4;padding:11px 13px;border-radius:10px;font-size:11px;margin-top:10px}
.total.bad{background:#f4e2df;color:#8f4b45}
.checklist{display:flex;flex-direction:column;gap:8px}
.step{display:grid;grid-template-columns:32px 1fr auto;gap:10px;align-items:center;padding:11px;border:1px solid var(--line);border-radius:11px;background:white}
.step .num{width:28px;height:28px;border-radius:50%;background:#e6d8c6;display:grid;place-items:center;font-weight:900;color:#604c3f}
.step.done .num{background:var(--espresso);color:#fff}
.step small{display:block;color:var(--muted);font-size:9px;margin-top:3px}
.data-actions{display:grid;gap:8px}
.placeholder{padding:48px 24px;text-align:center;border:1px dashed #cebda9;border-radius:16px;background:#faf5ed}
.placeholder b{font:500 25px Georgia,serif;color:var(--espresso);display:block}
.docs-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.doc-card{padding:16px;border:1px solid var(--line);border-radius:14px;background:#fffdf9}
.doc-card strong{display:block;font-family:Georgia,serif;font-size:17px;color:var(--espresso)}
.modal{position:fixed;inset:0;background:rgba(28,24,21,.62);display:none;align-items:center;justify-content:center;padding:20px;z-index:99}
.modal.show{display:flex}
.wizard{width:min(820px,96vw);background:var(--ivory);border-radius:22px;box-shadow:0 30px 80px rgba(0,0,0,.25);overflow:hidden}
.wiz-top{padding:22px 26px;background:linear-gradient(135deg,#302720,#1d1916);color:#fff}
.wiz-top h2{color:white} .wiz-body{padding:26px} .wiz-actions{display:flex;justify-content:space-between;gap:10px;padding:0 26px 24px}
.wiz-dots{display:flex;gap:6px;margin-top:12px} .wiz-dots i{width:28px;height:4px;border-radius:99px;background:rgba(255,255,255,.22)} .wiz-dots i.on{background:var(--champagne)}
.toast{position:fixed;right:20px;bottom:20px;background:#2c241f;color:#fff;padding:12px 16px;border-radius:10px;opacity:0;transform:translateY(8px);transition:.2s;z-index:120} .toast.show{opacity:1;transform:none}
@media(max-width:980px){.app{grid-template-columns:86px 1fr}.brand{height:78px}.nav button{grid-template-columns:1fr;text-align:center;padding:9px 4px}.nav .txt,.side-quote{display:none}.topbar,.content{padding-left:18px;padding-right:18px}.setup-layout,.grid2{grid-template-columns:1fr}.hero-grid{grid-template-columns:1fr}.health{justify-self:start;width:135px;height:135px}}
@media(max-width:700px){.app{display:block}.sidebar{position:relative;height:auto;display:block}.brand{height:95px}.nav{display:grid;grid-template-columns:repeat(5,1fr)}.nav button{font-size:12px}.nav .txt{display:none}.topbar{align-items:flex-start;flex-direction:column}.kpis,.grid3,.pipeline,.form-grid,.docs-grid{grid-template-columns:1fr 1fr}.content{padding-bottom:28px}}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><img alt="The Front Shelf" src="data:image/jpeg;base64,"></div>
    <nav class="nav" id="nav">
      <button class="active" data-view="home"><span>⌂</span><span class="txt"><b>HOME</b><small>Your overview</small></span></button>
      <button data-view="jobs"><span>▣</span><span class="txt"><b>JOBS</b><small>Application tracker</small></span></button>
      <button data-view="interviews"><span>◴</span><span class="txt"><b>INTERVIEWS</b><small>Prep studio</small></span></button>
      <button data-view="network"><span>◎</span><span class="txt"><b>NETWORK</b><small>Relationships</small></span></button>
      <button data-view="offers"><span>◇</span><span class="txt"><b>OFFERS</b><small>Decision center</small></span></button>
      <button data-view="analytics"><span>⌁</span><span class="txt"><b>ANALYTICS</b><small>Search intelligence</small></span></button>
      <button data-view="ai"><span>✦</span><span class="txt"><b>AI TOOLKIT</b><small>Prompt builder</small></span></button>
      <button data-view="weekly"><span>□</span><span class="txt"><b>WEEKLY PLAN</b><small>Your agenda</small></span></button>
      <button data-view="documents"><span>▤</span><span class="txt"><b>DOCUMENTS</b><small>Version tracker</small></span></button>
      <button data-view="setup"><span>⚙</span><span class="txt"><b>SETUP</b><small>Personalization</small></span></button>
    </nav>
    <div class="side-quote"><small>THE FRONT SHELF</small><strong>YOUR JOB SEARCH.<br>ORGANIZED.</strong></div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div><div class="eyebrow">The Front Shelf · Ultimate V2</div><h1 id="pageTitle">Welcome back</h1><div class="sub" id="pageSub">Your job search, prioritized.</div></div>
      <div style="display:flex;gap:8px"><button class="btn soft" id="openWizard">QUICK START</button><button class="btn primary" data-jump="setup">EDIT SETUP</button></div>
    </header>

    <div class="content">
      <section class="view active" id="home">
        <div class="hero">
          <div class="hero-grid">
            <div><div class="eyebrow" style="color:#d7c3a6">TODAY'S COMMAND CENTER</div><h2 id="greeting">Good morning.</h2><p id="heroCopy">You have a few things worth your attention today. Let's make the next move obvious.</p><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px"><span class="pill" id="heroInterview">0 interviews</span><span class="pill" id="heroFollow">0 follow-ups</span><span class="pill" id="heroApps">0 applications</span></div></div>
            <div class="health"><div style="text-align:center;z-index:1"><strong id="healthScore">78</strong><small>JOB SEARCH HEALTH</small></div></div>
          </div>
        </div>

        <div class="kpis" style="margin-top:14px">
          <div class="kpi"><strong id="kpiActive">0</strong><small>ACTIVE OPPORTUNITIES</small></div>
          <div class="kpi"><strong id="kpiInterview">0</strong><small>INTERVIEWS</small></div>
          <div class="kpi"><strong id="kpiFollow">0</strong><small>FOLLOW-UPS DUE</small></div>
          <div class="kpi"><strong id="kpiGoal">0%</strong><small>WEEKLY GOAL</small></div>
        </div>

        <div class="grid2">
          <article class="card">
            <div class="card-head"><div><div class="eyebrow">YOUR NEXT MOVE</div><h3>What deserves your attention</h3></div><button class="btn ghost" data-jump="weekly">WEEKLY PLAN</button></div>
            <div class="priority">
              <div class="priority-main"><div class="rank">1</div><div><b id="nextTitle">Set up your planner</b><div class="meta" id="nextMeta">Personalize your role, goals and priorities so the planner can work for you.</div></div><button class="btn primary" id="nextAction">DO THIS →</button></div>
            </div>
          </article>
          <article class="card">
            <div class="card-head"><div><div class="eyebrow">THIS WEEK</div><h3>Weekly momentum</h3></div><b id="weekPct">0%</b></div>
            <div class="progress"><i id="weekBar" style="width:0%"></i></div>
            <div id="weekStats" style="display:grid;gap:9px;margin-top:14px"></div>
          </article>
        </div>

        <div class="grid2">
          <article class="card"><div class="card-head"><div><div class="eyebrow">PIPELINE</div><h3>Where opportunities stand</h3></div><button class="btn ghost" data-jump="jobs">VIEW JOBS</button></div><div class="pipeline" id="pipeline"></div></article>
          <article class="card"><div class="eyebrow">SMART INSIGHTS</div><h3 style="margin-top:4px">What your data is saying</h3><div id="insights" style="margin-top:10px"></div></article>
        </div>
      </section>

      <section class="view" id="jobs"><div class="placeholder"><b>Jobs V2 foundation is ready.</b><p>Application Command Center is the next build. Your existing job data is preserved.</p></div></section>
      <section class="view" id="interviews"><div class="placeholder"><b>Interview Prep Studio is queued.</b><p>Your existing interview records remain available in browser storage.</p></div></section>
      <section class="view" id="network"><div class="placeholder"><b>Relationship Tracker is queued.</b><p>Contacts will connect directly to opportunities and follow-ups.</p></div></section>
      <section class="view" id="offers"><div class="placeholder"><b>Offers Decision Center is queued.</b><p>Weighted comparisons and negotiation tracking come later in V2.</p></div></section>
      <section class="view" id="analytics"><div class="placeholder"><b>Search Intelligence is queued.</b><p>Only real, calculated insights will appear here.</p></div></section>
      <section class="view" id="ai"><div class="placeholder"><b>AI-Ready Prompt Builder is queued.</b><p>No API key required. Prompts will be built locally from planner data.</p></div></section>
      <section class="view" id="weekly"><div class="placeholder"><b>Weekly Plan V2 is queued.</b><p>Tasks, goals and focus days will connect to the rest of the system.</p></div></section>

      <section class="view" id="documents">
        <div class="card">
          <div class="card-head"><div><div class="eyebrow">DOCUMENTS</div><h2>Resume & Letter Tracker</h2><div class="sub">Track versions now. Performance intelligence comes as your data grows.</div></div><button class="btn primary" id="addDoc">+ ADD DOCUMENT</button></div>
          <div class="kpis" style="margin-bottom:16px">
            <div class="kpi"><strong id="docCount">0</strong><small>DOCUMENTS TRACKED</small></div>
            <div class="kpi"><strong id="resumeCount">0</strong><small>RESUMES</small></div>
            <div class="kpi"><strong id="letterCount">0</strong><small>COVER LETTERS</small></div>
            <div class="kpi"><strong id="activeResume">—</strong><small>ACTIVE VERSION</small></div>
          </div>
          <div class="docs-grid" id="docGrid"></div>
        </div>
      </section>

      <section class="view" id="setup">
        <div class="setup-layout">
          <div>
            <article class="card">
              <div class="card-head"><div><div class="eyebrow">PERSONALIZATION HUB</div><h2>Build your job search system</h2><div class="sub">These settings power your dashboard, goals and future Fit Scores.</div></div><button class="btn primary" id="saveSetup">SAVE SETTINGS</button></div>
              <div class="form-grid">
                <label>Your name<input id="sName" placeholder="Sarah"></label>
                <label>Your location<input id="sLocation" placeholder="Montreal, QC"></label>
                <label>Primary target role<input id="sRole" placeholder="Content Researcher"></label>
                <label>Experience level<select id="sExp"><option>Entry-level</option><option>Mid-level</option><option>Senior</option><option>Career change</option></select></label>
                <label>Minimum salary<input id="sSalary" type="number" min="0" step="1000"></label>
                <label>Preferred work style<select id="sStyle"><option>Remote</option><option>Hybrid</option><option>On-site</option><option>Flexible</option></select></label>
                <label>Weekly application goal<input id="sGoal" type="number" min="1" max="50"></label>
                <label>Weekly networking goal<input id="sNetwork" type="number" min="0" max="50"></label>
                <label>Weekly follow-up goal<input id="sFollow" type="number" min="0" max="50"></label>
                <label>Target industries<input id="sIndustries" placeholder="Media, Research, Beauty"></label>
              </div>
              <div style="margin-top:18px"><div class="eyebrow">FOCUS DAYS</div><div class="days" id="dayPicker"></div></div>
            </article>

            <article class="card" style="margin-top:14px">
              <div class="card-head"><div><div class="eyebrow">JOB PRIORITIES</div><h3>What matters most to you?</h3><div class="sub">Weights must total 100%. These become the foundation of personalized Fit Scores.</div></div></div>
              <div id="weights"></div>
              <div class="total" id="weightTotal"><span>TOTAL WEIGHT</span><b>100%</b></div>
            </article>

            <article class="card" style="margin-top:14px">
              <div class="eyebrow">QUICK START</div><h3 style="margin-top:4px">Your onboarding progress</h3>
              <div class="checklist" id="setupSteps" style="margin-top:14px"></div>
            </article>
          </div>

          <aside>
            <article class="card"><div class="eyebrow">SETUP SUMMARY</div><h3 style="margin-top:4px">What powers your planner</h3><div id="summary" style="display:grid;gap:11px;margin-top:14px"></div></article>
            <article class="card" style="margin-top:14px"><div class="eyebrow">YOUR DATA</div><h3 style="margin-top:4px">Local & portable</h3><p class="sub">This planner stores data in this browser. Export a backup before clearing browser data or moving devices.</p><div class="data-actions"><button class="btn primary" id="exportData">EXPORT BACKUP</button><label class="btn soft" style="text-align:center">IMPORT BACKUP<input id="importData" type="file" accept=".json" hidden></label><button class="btn danger" id="resetData">RESET PLANNER</button></div></article>
          </aside>
        </div>
      </section>
    </div>
  </main>
</div>

<div class="modal" id="wizard">
  <div class="wizard">
    <div class="wiz-top"><div class="eyebrow" style="color:#d7c3a6">WELCOME TO THE FRONT SHELF</div><h2>Let's build your job search system.</h2><div class="wiz-dots" id="wizDots"></div></div>
    <div class="wiz-body" id="wizBody"></div>
    <div class="wiz-actions"><button class="btn ghost" id="wizBack">BACK</button><button class="btn primary" id="wizNext">CONTINUE →</button></div>
  </div>
</div>
<div class="toast" id="toast">Saved.</div>

<script>
const KEY="frontShelfJobSearchSystemV1";
const DEFAULT={
 settings:{name:"",location:"",targetTitle:"Content Researcher",experience:"Mid-level",minSalary:60000,arrangement:"Remote",goal:5,networkGoal:2,followGoal:3,industries:"",searchDays:[1,1,1,1,1,0,0],priorities:{"Work-Life Balance":25,"Growth & Learning":20,"Compensation":20,"Company Culture":15,"Remote Flexibility":10,"Job Stability":5,"Impact & Purpose":5},setupComplete:false,wizardSeen:false},
 jobs:[],interviews:[],network:[],offers:[],tasks:[],documents:[]
};
let raw; try{raw=JSON.parse(localStorage.getItem(KEY)||"null")}catch(e){raw=null}
let data=raw||structuredClone(DEFAULT);
data.settings={...structuredClone(DEFAULT.settings),...(data.settings||{})};
data.settings.priorities={...structuredClone(DEFAULT.settings.priorities),...(data.settings.priorities||{})};
for(const k of ["jobs","interviews","network","offers","tasks","documents"]) if(!Array.isArray(data[k])) data[k]=[];
if(!Array.isArray(data.settings.searchDays)) data.settings.searchDays=[1,1,1,1,1,0,0];
const $=q=>document.querySelector(q), $$=q=>[...document.querySelectorAll(q)];
const save=()=>{localStorage.setItem(KEY,JSON.stringify(data));};
function toast(msg="Saved."){$("#toast").textContent=msg;$("#toast").classList.add("show");setTimeout(()=>$("#toast").classList.remove("show"),1800)}
function todayISO(){return new Date().toISOString().slice(0,10)}
function dueFollowups(){return data.jobs.filter(j=>j.followUp && j.followUp<=todayISO() && !["Rejected","Withdrawn","Accepted"].includes(j.status))}
function appliedJobs(){return data.jobs.filter(j=>j.dateApplied)}
function activeJobs(){return data.jobs.filter(j=>!["Rejected","Withdrawn","Accepted"].includes(j.status))}
function renderHome(){
 const s=data.settings;
 $("#greeting").textContent=s.name?`Good morning, ${s.name}.`:"Good morning.";
 $("#heroCopy").textContent=s.targetTitle?`You're building toward ${s.targetTitle}. Here's what deserves your attention today.`:"Here's what deserves your attention today.";
 $("#heroInterview").textContent=`${data.interviews.length} interview${data.interviews.length===1?"":"s"}`;
 $("#heroFollow").textContent=`${dueFollowups().length} follow-up${dueFollowups().length===1?"":"s"} due`;
 $("#heroApps").textContent=`${appliedJobs().length} applications tracked`;
 $("#kpiActive").textContent=activeJobs().length; $("#kpiInterview").textContent=data.interviews.length; $("#kpiFollow").textContent=dueFollowups().length;
 const goal=Math.max(1,+s.goal||5), apps=appliedJobs().length, ratio=Math.min(1,apps/goal);
 $("#kpiGoal").textContent=Math.round(ratio*100)+"%"; $("#weekPct").textContent=Math.round(ratio*100)+"%"; $("#weekBar").style.width=Math.round(ratio*100)+"%";
 $("#weekStats").innerHTML=`<div style="display:flex;justify-content:space-between"><span>Applications</span><b>${apps} / ${goal}</b></div><div style="display:flex;justify-content:space-between"><span>Networking</span><b>${data.network.length} / ${s.networkGoal||0}</b></div><div style="display:flex;justify-content:space-between"><span>Follow-ups due</span><b>${dueFollowups().length}</b></div>`;
 const statuses=["Saved","Applied","Screening","Interview","Offer"]; $("#pipeline").innerHTML=statuses.map(st=>`<div class="pipe"><strong>${data.jobs.filter(j=>j.status===st).length}</strong><span>${st.toUpperCase()}</span></div>`).join("");
 let nextTitle="Set up your planner", nextMeta="Personalize your role, goals and priorities so the planner can work for you.", jump="setup";
 if(s.setupComplete){
   const fu=dueFollowups()[0];
   if(fu){nextTitle=`Follow up with ${fu.company}`; nextMeta=`This opportunity has a follow-up due. Keep momentum while the application is warm.`; jump="jobs";}
   else if(data.interviews[0]){nextTitle=`Prepare for ${data.interviews[0].company}`;nextMeta=`You have an interview in your tracker. Prep beats panic.`;jump="interviews";}
   else{nextTitle="Add your next target opportunity";nextMeta="A focused pipeline gives the rest of the planner something useful to optimize.";jump="jobs";}
 }
 $("#nextTitle").textContent=nextTitle;$("#nextMeta").textContent=nextMeta;$("#nextAction").onclick=()=>showView(jump);
 const insights=[];
 if(!data.jobs.length) insights.push(["✦","Add your first opportunity","Your analytics and Fit Scores become useful as soon as you start tracking jobs."]);
 if(dueFollowups().length) insights.push(["!","Follow-up window","You have "+dueFollowups().length+" follow-up"+(dueFollowups().length===1?"":"s")+" due."]);
 if(data.jobs.length>=3){const src={};data.jobs.forEach(j=>src[j.source]=(src[j.source]||0)+1);const top=Object.entries(src).sort((a,b)=>b[1]-a[1])[0];if(top)insights.push(["↗",top[0]+" is your most-used source",top[1]+" opportunities in your tracker came from here."]);}
 if(!insights.length) insights.push(["✓","You're organized","No overdue follow-ups right now. Keep building quality opportunities."]);
 $("#insights").innerHTML=insights.slice(0,3).map(x=>`<div class="insight"><div class="ico">${x[0]}</div><div><b>${x[1]}</b><div class="meta">${x[2]}</div></div></div>`).join("");
 const checks=setupChecks(); const setupScore=checks.filter(Boolean).length/6;
 let health=Math.round(55+setupScore*20+Math.min(15,data.jobs.length*3)+Math.min(10,data.interviews.length*5)); $("#healthScore").textContent=Math.min(100,health);
}
function setupChecks(){
 const s=data.settings,total=Object.values(s.priorities).reduce((a,b)=>a+(+b||0),0);
 return [!!s.name,!!s.targetTitle,!!s.goal,!!s.minSalary,s.searchDays.some(Boolean),total===100];
}
function renderSetup(){
 const s=data.settings;
 $("#sName").value=s.name||"";$("#sLocation").value=s.location||"";$("#sRole").value=s.targetTitle||"";$("#sExp").value=s.experience||"Mid-level";$("#sSalary").value=s.minSalary||"";$("#sStyle").value=s.arrangement||"Remote";$("#sGoal").value=s.goal||5;$("#sNetwork").value=s.networkGoal||2;$("#sFollow").value=s.followGoal||3;$("#sIndustries").value=s.industries||"";
 const dayNames=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];$("#dayPicker").innerHTML=dayNames.map((d,i)=>`<button class="day ${s.searchDays[i]?"on":""}" data-day="${i}">${d}</button>`).join("");
 $("#weights").innerHTML=Object.entries(s.priorities).map(([k,v])=>`<div class="weight"><span>${k}</span><input type="range" min="0" max="50" step="5" value="${v}" data-weight="${k}"><output>${v}%</output></div>`).join("");
 updateWeightTotal();
 const c=setupChecks(),labels=[["Tell us about yourself","Name and location"],["Define your target role","What are you aiming for?"],["Set a weekly goal","Choose a sustainable target"],["Set your salary target","Know your minimum"],["Choose focus days","Protect your time"],["Weight job priorities","Power your future Fit Score"]];
 $("#setupSteps").innerHTML=labels.map((x,i)=>`<div class="step ${c[i]?"done":""}"><div class="num">${c[i]?"✓":i+1}</div><div><b>${x[0]}</b><small>${x[1]}</small></div><span class="pill">${c[i]?"DONE":"TO DO"}</span></div>`).join("");
 $("#summary").innerHTML=`<div><small class="eyebrow">PRIMARY ROLE</small><b style="display:block;margin-top:4px">${s.targetTitle||"Not set"}</b></div><div><small class="eyebrow">SALARY FLOOR</small><b style="display:block;margin-top:4px">${s.minSalary?"$"+Number(s.minSalary).toLocaleString()+"+":"Not set"}</b></div><div><small class="eyebrow">WORK STYLE</small><b style="display:block;margin-top:4px">${s.arrangement||"Not set"}</b></div><div><small class="eyebrow">FOCUS DAYS</small><b style="display:block;margin-top:4px">${dayNames.filter((d,i)=>s.searchDays[i]).join(", ")||"Not set"}</b></div>`;
}
function updateWeightTotal(){
 const total=$$("#weights input[data-weight]").reduce((a,x)=>a+(+x.value||0),0), el=$("#weightTotal"); el.querySelector("b").textContent=total+"%";el.classList.toggle("bad",total!==100); return total;
}
function collectSetup(){
 const s=data.settings; s.name=$("#sName").value.trim();s.location=$("#sLocation").value.trim();s.targetTitle=$("#sRole").value.trim();s.experience=$("#sExp").value;s.minSalary=+$("#sSalary").value||0;s.arrangement=$("#sStyle").value;s.goal=+$("#sGoal").value||5;s.networkGoal=+$("#sNetwork").value||0;s.followGoal=+$("#sFollow").value||0;s.industries=$("#sIndustries").value.trim();
 const p={}; $$("#weights input[data-weight]").forEach(x=>p[x.dataset.weight]=+x.value);s.priorities=p;s.setupComplete=setupChecks().every(Boolean);
}
$("#dayPicker").onclick=e=>{if(!e.target.matches("[data-day]"))return;const i=+e.target.dataset.day;data.settings.searchDays[i]=data.settings.searchDays[i]?0:1;renderSetup();};
$("#weights").oninput=e=>{if(e.target.matches("[data-weight]")){e.target.nextElementSibling.textContent=e.target.value+"%";updateWeightTotal();}};
$("#saveSetup").onclick=()=>{collectSetup();if(updateWeightTotal()!==100){toast("Priorities must total 100%.");return};save();renderAll();toast("Setup saved.");};
function renderDocuments(){
 const docs=data.documents||[];$("#docCount").textContent=docs.length;$("#resumeCount").textContent=docs.filter(d=>d.type==="Resume").length;$("#letterCount").textContent=docs.filter(d=>d.type==="Cover Letter").length;$("#activeResume").textContent=docs.find(d=>d.type==="Resume"&&d.status==="Active")?.version||"—";
 $("#docGrid").innerHTML=docs.length?docs.map(d=>`<div class="doc-card"><span class="pill">${d.type}</span><strong style="margin-top:9px">${d.name}</strong><div class="meta">${d.version||""} · ${d.status||"Active"}</div><div class="meta">${d.target||"General"}${d.link?` · <a href="${d.link}" target="_blank">Open link</a>`:""}</div></div>`).join(""):`<div class="placeholder" style="grid-column:1/-1;padding:30px"><b>No documents yet.</b><p>Add a resume or cover-letter version to start tracking which materials you use.</p></div>`;
}
$("#addDoc").onclick=()=>{const name=prompt("Document name (example: Resume — Content Research V3)");if(!name)return;const type=prompt("Type: Resume, Cover Letter, or Other","Resume")||"Other";const version=prompt("Version","V1")||"";const target=prompt("Target role / company","General")||"";data.documents.push({id:Date.now(),name,type,version,target,status:"Active",link:""});save();renderDocuments();toast("Document added.");};
function renderAll(){renderHome();renderSetup();renderDocuments();}
const titles={home:["Welcome back","Your job search, prioritized."],jobs:["Jobs","Application Command Center"],interviews:["Interviews","Prep Studio"],network:["Network","Relationship Tracker"],offers:["Offers","Decision Center"],analytics:["Analytics","Search Intelligence"],ai:["AI Toolkit","Personalized prompt builder"],weekly:["Weekly Plan","Your job-search agenda"],documents:["Documents","Resume & Letter Tracker"],setup:["Setup","Personalization Hub"]};
function showView(id){$$(".view").forEach(v=>v.classList.toggle("active",v.id===id));$$(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.view===id));$("#pageTitle").textContent=titles[id][0];$("#pageSub").textContent=titles[id][1];window.scrollTo({top:0,behavior:"smooth"});}
$("#nav").onclick=e=>{const b=e.target.closest("button[data-view]");if(b)showView(b.dataset.view)};$$("[data-jump]").forEach(b=>b.onclick=()=>showView(b.dataset.jump));
$("#exportData").onclick=()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="the-front-shelf-backup.json";a.click();URL.revokeObjectURL(a.href)};
$("#importData").onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{data=JSON.parse(r.result);save();location.reload()}catch(err){toast("That backup file couldn't be read.")}};r.readAsText(f)};
$("#resetData").onclick=()=>{if(confirm("Reset all planner data on this device? This cannot be undone unless you exported a backup.")){localStorage.removeItem(KEY);location.reload()}};
let wizStep=0;
const wizSteps=[
()=>`<div class="eyebrow">STEP 1 OF 6</div><h2 style="margin-top:5px">Tell us about you</h2><p class="sub">Personalize the planner so it feels like yours.</p><div class="form-grid" style="margin-top:16px"><label>Your name<input id="wName" value="${data.settings.name||""}" placeholder="Sarah"></label><label>Location<input id="wLocation" value="${data.settings.location||""}" placeholder="Montreal, QC"></label></div>`,
()=>`<div class="eyebrow">STEP 2 OF 6</div><h2 style="margin-top:5px">Define your target</h2><p class="sub">What role are you moving toward?</p><div class="form-grid" style="margin-top:16px"><label>Primary target role<input id="wRole" value="${data.settings.targetTitle||""}"></label><label>Experience level<select id="wExp">${["Entry-level","Mid-level","Senior","Career change"].map(x=>`<option ${x===data.settings.experience?"selected":""}>${x}</option>`).join("")}</select></label></div>`,
()=>`<div class="eyebrow">STEP 3 OF 6</div><h2 style="margin-top:5px">Set sustainable goals</h2><p class="sub">Quality over panic-applying.</p><div class="form-grid" style="margin-top:16px"><label>Applications / week<input id="wGoal" type="number" value="${data.settings.goal||5}"></label><label>Networking / week<input id="wNet" type="number" value="${data.settings.networkGoal||2}"></label></div>`,
()=>`<div class="eyebrow">STEP 4 OF 6</div><h2 style="margin-top:5px">Set your minimums</h2><p class="sub">Your salary floor and work style help future Fit Scores.</p><div class="form-grid" style="margin-top:16px"><label>Minimum salary<input id="wSalary" type="number" value="${data.settings.minSalary||60000}"></label><label>Work style<select id="wStyle">${["Remote","Hybrid","On-site","Flexible"].map(x=>`<option ${x===data.settings.arrangement?"selected":""}>${x}</option>`).join("")}</select></label></div>`,
()=>`<div class="eyebrow">STEP 5 OF 6</div><h2 style="margin-top:5px">Choose your focus days</h2><p class="sub">Your consistency score should respect the days you actually planned to search.</p><div class="days" style="margin-top:18px">${["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].map((d,i)=>`<button class="day ${data.settings.searchDays[i]?"on":""}" data-wday="${i}">${d}</button>`).join("")}</div>`,
()=>`<div class="eyebrow">STEP 6 OF 6</div><h2 style="margin-top:5px">You're ready.</h2><p class="sub">Your dashboard will now use your target role, goals, focus days and priorities. You can fine-tune priority weights anytime in Setup.</p><div class="card" style="margin-top:16px;background:#efe4d4"><b>${data.settings.targetTitle||"Your target role"}</b><div class="meta">${data.settings.arrangement} · ${data.settings.minSalary?"$"+Number(data.settings.minSalary).toLocaleString()+"+":"Salary not set"} · ${data.settings.goal||5} applications/week</div></div>`
];
function saveWizStep(){
 const s=data.settings;
 if(wizStep===0){s.name=$("#wName")?.value.trim()||s.name;s.location=$("#wLocation")?.value.trim()||s.location}
 if(wizStep===1){s.targetTitle=$("#wRole")?.value.trim()||s.targetTitle;s.experience=$("#wExp")?.value||s.experience}
 if(wizStep===2){s.goal=+$("#wGoal")?.value||s.goal;s.networkGoal=+$("#wNet")?.value||s.networkGoal}
 if(wizStep===3){s.minSalary=+$("#wSalary")?.value||s.minSalary;s.arrangement=$("#wStyle")?.value||s.arrangement}
}
function renderWiz(){$("#wizBody").innerHTML=wizSteps[wizStep]();$("#wizDots").innerHTML=wizSteps.map((_,i)=>`<i class="${i<=wizStep?"on":""}"></i>`).join("");$("#wizBack").style.visibility=wizStep===0?"hidden":"visible";$("#wizNext").textContent=wizStep===wizSteps.length-1?"BUILD MY DASHBOARD →":"CONTINUE →";$("#wizBody").onclick=e=>{if(e.target.matches("[data-wday]")){const i=+e.target.dataset.wday;data.settings.searchDays[i]=data.settings.searchDays[i]?0:1;renderWiz()}}}
function openWizard(){wizStep=0;$("#wizard").classList.add("show");renderWiz()}
$("#openWizard").onclick=openWizard;$("#wizBack").onclick=()=>{saveWizStep();wizStep=Math.max(0,wizStep-1);renderWiz()};$("#wizNext").onclick=()=>{saveWizStep();if(wizStep<wizSteps.length-1){wizStep++;renderWiz()}else{data.settings.wizardSeen=true;data.settings.setupComplete=setupChecks().every(Boolean);save();$("#wizard").classList.remove("show");renderAll();showView("home");toast("Your dashboard is ready.")}};
renderAll();
if(!data.settings.wizardSeen && !raw) setTimeout(openWizard,350);
</script>
